public class Product implements iProducts {
    private String[] productNames;
    private int[][] salesData; // Rows = products, Columns = months

    public Product(String[] productNames, int[][] salesData) {
        this.productNames = productNames;
        this.salesData = salesData;
    }

    @Override
    public int GetTotalProductsSold() {
        int total = 0;
        for (int i = 0; i < salesData.length; i++) {
            for (int j = 0; j < salesData[i].length; j++) {
                total += salesData[i][j];
            }
        }
        return total;
    }

    @Override
    public double GetAverageProductSold() {
        int totalProducts = GetTotalProductsSold();
        int totalEntries = 0;
        for (int i = 0; i < salesData.length; i++) {
            totalEntries += salesData[i].length;
        }
        return totalEntries == 0 ? 0.0 : (double) totalProducts / totalEntries;
    }

    @Override
    public String GetMostPopularProduct() {
        int maxSales = -1;
        int bestIndex = 0;

        for (int i = 0; i < salesData.length; i++) {
            int currentProductTotal = 0;
            for (int j = 0; j < salesData[i].length; j++) {
                currentProductTotal += salesData[i][j];
            }
            if (currentProductTotal > maxSales) {
                maxSales = currentProductTotal;
                bestIndex = i;
            }
        }
        return productNames[bestIndex] + " (" + maxSales + ")";
    }
}
